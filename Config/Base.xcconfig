#include "Version.xcconfig"
#include? "Signing.xcconfig"

PRODUCT_NAME = UZee
IPHONEOS_DEPLOYMENT_TARGET = 26.0
TARGETED_DEVICE_FAMILY = 1,2
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = UZee
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.finance
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
CODE_SIGN_STYLE = Automatic
ENABLE_PREVIEWS = YES
INFOPLIST_KEY_NSCameraUsageDescription = UZee uses the camera to photograph receipts you attach to transactions.
INFOPLIST_KEY_NSMicrophoneUsageDescription = UZee listens when you tap the mic in Ask UZee, so you can ask about your money or log something by voice.
INFOPLIST_KEY_NSSpeechRecognitionUsageDescription = UZee turns what you say in Ask UZee into text on this iPhone. Your voice is not sent anywhere.
INFOPLIST_KEY_NSFaceIDUsageDescription = UZee uses Face ID to unlock the app when you turn on the lock in Settings.
INFOPLIST_KEY_NSLocationWhenInUseUsageDescription = UZee uses your location to work out namaz times and the Qibla direction where you are. It stays on this iPhone.
INFOPLIST_KEY_NSCalendarsFullAccessUsageDescription = UZee adds your bills, events and loan dates to the calendar you choose, and keeps only its own events up to date.
