<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the generated Info.plist. The backup file type, so Files knows a .uzeebackup is UZee's (owner, 2026-11-03). -->
<plist version="1.0">
<dict>
	<key>NSHumanReadableCopyright</key>
	<string>Built by iUmer Farooq. © 2026 iUmer Farooq. All rights reserved.</string>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>app.uzee.backup</string>
			<key>UTTypeDescription</key>
			<string>UZee backup</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>uzeebackup</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
